{
    "name": "gggeek/ggwebservices",
    "description": "Webservices for Exponential: serve and call JSON-RPC, XML-RPC, REST and SOAP (with WSDL) from PHP and templates, a cross-domain proxy for Ajax calls, and a visual webservices debugger in the administration interface.",
    "type": "ezpublish-legacy-extension",
    "keywords": ["exponential", "exponential-extension", "ezpublish-legacy", "webservices", "jsonrpc", "xmlrpc", "soap", "wsdl", "rest", "debugger"],
    "homepage": "https://github.com/se7enxweb/ggwebservices",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Gaetano Giunta",
            "homepage": "https://github.com/gggeek",
            "role": "Original author"
        },
        {
            "name": "7x",
            "homepage": "https://se7enx.com",
            "email": "info@se7enx.com",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/se7enxweb/ggwebservices/issues",
        "source": "https://github.com/se7enxweb/ggwebservices"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.0",
        "se7enxweb/ezpublish-legacy-installer": "*"
    },
    "suggest": {
        "ext-json": "Needed to support JSON-RPC calls",
        "ext-soap": "Needed to support SOAP calls",
        "ext-xmlrpc": "Needed to support XML-RPC calls (a PECL extension since PHP 8.0)",
        "ext-curl": "Lets the client send HTTP 1.1 requests (Options[forceCURL])",
        "ext-zlib": "Lets the client send and accept compressed requests and responses"
    },
    "require-dev": {
        "gggeek/ezextensionbuilder": "*"
    },
    "extra": {
        "installer-name": "ggwebservices",
        "ezpublish-legacy-extension-name": "ggwebservices"
    }
}
